#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>; /* Sesuaikan jumlah kolom jika diperlukan */
        rows = <3>;
        map = <
            RC(0,3)
            RC(0,0) RC(0,1) RC(0,2) 
            RC(1,0) RC(1,1) RC(1,2)
            RC(2,0) RC(2,1) RC(2,2)
        >;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "SAFANI_KSCAN";
        diode-direction = "row2col";
        wakeup-source;

        row-gpios =
            <&gpio0 11 GPIO_ACTIVE_HIGH>, /* P0.11 Row 0 */
            <&gpio1 4  GPIO_ACTIVE_HIGH>, /* P1.04 Row 1 */
            <&gpio1 6  GPIO_ACTIVE_HIGH>, /* P1.06 Row 2 */
            <&gpio1 13 GPIO_ACTIVE_HIGH>; /* P1.13 Row 3 / encoder SW */

        col-gpios =
            <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, /* P0.09 */
            <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, /* P0.10 */
            <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* P1.11 */

        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
    };
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Safani9 Top-Left Encoder Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        /* 
          Urutan tombol harus sama persis dengan urutan tombol/switch yang didefinisikan 
          pada 'map' matrix-transform Anda. 
          Contoh di bawah menempatkan encoder/tombol pertama di (0,0) dan 9 tombol lainnya di sebelah kanan/bawahnya.
        */
        keys 
            = <&key_physical_attrs 100 100    0    0       0     0     0> /* Posisi Encoder (Kiri Atas / 0,0) */
            , <&key_physical_attrs 100 100  100    0       0     0     0> /* Tombol 1 */
            , <&key_physical_attrs 100 100  200    0       0     0     0> /* Tombol 2 */
            , <&key_physical_attrs 100 100  300    0       0     0     0> /* Tombol 3 */
            , <&key_physical_attrs 100 100    0  100       0     0     0> /* Tombol 4 */
            , <&key_physical_attrs 100 100  100  100       0     0     0> /* Tombol 5 */
            , <&key_physical_attrs 100 100  200  100       0     0     0> /* Tombol 6 */
            , <&key_physical_attrs 100 100    0  200       0     0     0> /* Tombol 7 */
            , <&key_physical_attrs 100 100  100  200       0     0     0> /* Tombol 8 */
            , <&key_physical_attrs 100 100  200  200       0     0     0> /* Tombol 9 */
            ;
    };
};
